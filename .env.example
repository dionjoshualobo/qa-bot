# WhatsApp Configuration
# Path where WhatsApp session data will be stored
SESSION_PATH=./.baileys_auth

# Database Configuration
# Path to the SQLite database file
DATABASE_PATH=./qa-bot.db

# Bot Configuration
# WhatsApp Group ID where questions will be posted
# Format: <country_code><phone_number>-<timestamp>@g.us
# Example: 1234567890-1234567890@g.us
GROUP_ID=

# Optional: WhatsApp ID of the account allowed to approve/reject questions.
# When unset, the connected account itself is used (recommended when the bot
# runs on your own WhatsApp account).
# Format: <country_code><phone_number>@s.whatsapp.net
# Example: 1234567890@s.whatsapp.net
# OWNER_WHATSAPP_ID=

# Logging Configuration
# Log level: debug, info, warn, error
LOG_LEVEL=info
